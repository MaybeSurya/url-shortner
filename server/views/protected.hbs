<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} — SURYA</title>
  <link rel="icon" href="/images/favicon.ico">
  <style>
    :root {
      --bg: #09090b;
      --card-bg: rgba(18, 18, 22, 0.85);
      --border: rgba(255, 255, 255, 0.1);
      --text: #f4f4f5;
      --text-muted: #a1a1aa;
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --error: #ef4444;
      --error-bg: rgba(239, 68, 68, 0.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      padding: 20px;
      position: relative;
      overflow-x: hidden;
    }
    .grid-pattern {
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.04;
      background-image: linear-gradient(var(--text) 1px, transparent 1px), linear-gradient(90deg, var(--text) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    header {
      width: 100%;
      max-width: 1000px;
      padding: 16px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
    }
    .brand {
      font-family: monospace;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text);
      text-decoration: none;
      font-size: 14px;
    }
    main {
      width: 100%;
      max-width: 440px;
      margin: auto 0;
      z-index: 10;
    }
    .card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px 28px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .icon-badge {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: rgba(99, 102, 241, 0.12);
      border: 1px solid rgba(99, 102, 241, 0.25);
      color: var(--primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    h1 {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 8px;
      letter-spacing: -0.02em;
    }
    p.desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 24px;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 16px;
      text-align: left;
    }
    label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    input[type="password"] {
      width: 100%;
      height: 44px;
      padding: 0 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text);
      font-size: 14px;
      outline: none;
      transition: all 0.2s ease;
      margin-top: 6px;
    }
    input[type="password"]:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }
    button.btn-primary {
      width: 100%;
      height: 44px;
      border-radius: 10px;
      border: none;
      background: var(--text);
      color: #000;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: opacity 0.2s ease;
    }
    button.btn-primary:hover {
      opacity: 0.9;
    }
    button.btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .error-box {
      background: var(--error-bg);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: var(--error);
      font-size: 12px;
      padding: 10px 12px;
      border-radius: 8px;
      display: none;
    }
    footer {
      width: 100%;
      max-width: 1000px;
      padding: 20px 0;
      text-align: center;
      font-size: 12px;
      color: var(--text-muted);
      z-index: 10;
    }
  </style>
</head>
<body>
  <div class="grid-pattern"></div>

  <header>
    <a href="/" class="brand">SURYA</a>
  </header>

  <main>
    <div class="card">
      <div class="icon-badge">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>

      <h1>Protected Short Link</h1>
      <p class="desc">This link is password protected. Enter the password below to be redirected to your destination.</p>

      <form id="protected-form">
        <div>
          <label for="password-input">Password</label>
          <input type="password" id="password-input" name="password" placeholder="Enter password…" required autofocus />
        </div>

        <div id="error-message" class="error-box"></div>

        <button type="submit" id="submit-btn" class="btn-primary">
          <span>Unlock &amp; Go</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
    </div>
  </main>

  <footer>
    <p>© 2026 Surya's URL Shortening Service. All rights reserved.</p>
  </footer>

  <script>
    document.getElementById('protected-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = document.getElementById('password-input').value;
      const errorEl = document.getElementById('error-message');
      const btn = document.getElementById('submit-btn');

      errorEl.style.display = 'none';
      btn.disabled = true;
      btn.innerHTML = 'Unlocking...';

      try {
        const res = await fetch('/api/v2/links/{{id}}/protected', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });

        const data = await res.json();

        if (res.ok && (data.target || res.headers.get('HX-Redirect'))) {
          const redirectUrl = data.target || res.headers.get('HX-Redirect');
          window.location.href = redirectUrl;
        } else {
          errorEl.innerText = data.message || 'Password is not correct.';
          errorEl.style.display = 'block';
          btn.disabled = false;
          btn.innerHTML = 'Unlock &amp; Go &rarr;';
        }
      } catch (err) {
        errorEl.innerText = 'An unexpected error occurred. Please try again.';
        errorEl.style.display = 'block';
        btn.disabled = false;
        btn.innerHTML = 'Unlock &amp; Go &rarr;';
      }
    });
  </script>
</body>
</html>