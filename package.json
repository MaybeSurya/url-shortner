{
  "name": "surya-url-shortener",
  "version": "1.0.0",
  "description": "Surya's URL Shortening Service - Fast, reliable and privacy-focused link management built for developers, businesses and creators.",
  "main": "./server/server.js",
  "scripts": {
    "dev:server": "node --watch-path=./server --watch-path=./custom server/server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "node server/server.js --production",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "lint": "eslint client/src --max-warnings 0",
    "lint:fix": "eslint client/src --fix",
    "docs:build": "cd docs/api && node generate && cd ../.."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/surya/url-shortener"
  },
  "keywords": [
    "url-shortener",
    "surya",
    "link-management",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Surya",
  "license": "MIT",
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "@tanstack/react-query": "^5.51.23",
    "axios": "^1.7.3",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.8.1",
    "bull": "^4.16.5",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "1.4.7",
    "cookie-session": "2.1.1",
    "cors": "2.8.5",
    "date-fns": "2.30.0",
    "dotenv": "16.4.7",
    "envalid": "8.0.0",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "express-useragent": "2.2.1",
    "express-validator": "6.14.2",
    "framer-motion": "^11.3.24",
    "geoip-lite": "^2.0.3",
    "gsap": "^3.15.0",
    "hbs": "4.2.1",
    "helmet": "7.1.0",
    "ioredis": "5.4.2",
    "isbot": "5.1.19",
    "jsonwebtoken": "9.0.2",
    "knex": "3.1.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.424.0",
    "ms": "2.1.3",
    "mysql2": "3.12.0",
    "nanoid": "3.3.8",
    "nodemailer": "^9.0.4",
    "openid-client": "5.7.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "passport-localapikey-update": "0.6.0",
    "pg": "8.13.1",
    "pg-query-stream": "4.7.1",
    "rate-limit-redis": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "6.30.4",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.4.0",
    "uuid": "^14.0.1"
  },
  "overrides": {
    "bull": {
      "uuid": "^11.1.1"
    },
    "esbuild": "^0.25.0",
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4",
    "@remix-run/router": "1.23.3",
    "launch-editor": "^3.2.0",
